// Copia questo file in `Secrets.xcconfig` (stessa cartella) e inserisci i tuoi valori.
// `Secrets.xcconfig` è in .gitignore: NON committare le chiavi reali.
//
// Trovi questi valori su Supabase -> Project Settings -> API.
//
// Nota: nelle stringhe xcconfig il carattere "//" verrebbe interpretato come commento,
// quindi l'URL va inserito SENZA "https://" (viene aggiunto dal codice).

SUPABASE_URL = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
